# Single-page app: the site's real addresses (/contatti, /lavori/some-project,
# /privacy ...) are served index.html so a refresh or a direct link works.
# Any other address gets a true 404 status (see ErrorDocument below) while
# still showing the app's own "page not found" screen. Project slugs live in
# the CMS, so /lavori/<anything> is let through and the app shows "Progetto
# non trovato" (with noindex) for unknown ones. When adding a page to
# src/lib/routes.ts, add it to the list below too.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Old English addresses -> the Italian ones (permanent, keeps ?query).
  RewriteRule ^work/?$ /lavori [R=301,L,QSA]
  RewriteRule ^work/(.+)$ /lavori/$1 [R=301,L,QSA]
  RewriteRule ^contact/?$ /contatti [R=301,L,QSA]
  RewriteRule ^careers/?$ /lavora-con-noi [R=301,L,QSA]
  RewriteRule ^index\.html$ - [L]
  RewriteRule ^(lavori(/[^/]+)?|studio|contatti|lavora-con-noi|privacy|cookies)/?$ /index.html [L]
</IfModule>

# Unknown address: real 404 status, body is the app (React Router renders its
# not-found page for any path it has no route for).
ErrorDocument 404 /index.html

# Hashed build files never change under the same name: cache them for a year.
<IfModule mod_headers.c>
  <FilesMatch "^.*\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
